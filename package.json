{
  "name": "wikimaps",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas mondial interactif, open source et gratuit — la carte est l'interface.",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/copy-data.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "tsx scripts/pipeline/fetch.ts",
    "data:enrich": "tsx scripts/pipeline/enrich-wikidata.ts",
    "data:transform": "tsx scripts/pipeline/transform.ts",
    "data:validate": "tsx scripts/pipeline/validate.ts",
    "data:seed-europe": "tsx scripts/pipeline/seed-europe.ts",
    "data:build": "npm run data:fetch && npm run data:enrich && npm run data:transform && npm run data:validate",
    "prepare": "husky"
  },
  "dependencies": {
    "@turf/simplify": "^7.3.5",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.1",
    "@types/osmtogeojson": "^2.2.34",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}

# Variables d'environnement WikiMaps — copier en .env.local pour le dev.
# Toutes les variables exposées au navigateur DOIVENT être préfixées NEXT_PUBLIC_.
# (Export statique : ces valeurs sont inlinées au build.)

# ── Observabilité (à activer pré-lancement, Phase 6) ─────────────────────────
# Suivi des erreurs côté client (Sentry). Vide = désactivé.
NEXT_PUBLIC_SENTRY_DSN=

# Analytics privacy-first (Plausible). Domaine suivi, ex : wikimaps.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# WikiMaps environment variables — copy to .env.local for development.
# Any variable exposed to the browser MUST be prefixed with NEXT_PUBLIC_.
# (Static export: these values are inlined at build time.)

# ── Observability (enable pre-launch, Phase 6) ───────────────────────────────
# Client-side error tracking (Sentry). Empty = disabled.
NEXT_PUBLIC_SENTRY_DSN=

# Privacy-first analytics (Plausible). Tracked domain, e.g. wikimaps.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
